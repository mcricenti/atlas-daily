{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atlas-daily",
  "compatibility_date": "2026-11-14",
  // Workers SPA (Vite + Cloudflare plugin). For Pages, set build output to `dist` in the dashboard.
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
